{
	// Cấu hình Worker cho VyLing trên Cloudflare.
	//
	// `main` KHÔNG khai ở đây: plugin @flue/vite tự đóng góp Worker entry
	// (và Durable Object binding của từng agent) qua flueWorkerConfig()
	// trong vite.config.ts.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vyling",
	"compatibility_date": "2026-06-01",

	// nodejs_compat: Flue runtime + MCP SDK cần.
	// experimental: bắt buộc cho Worker Loader (Code Mode).
	"compatibility_flags": ["nodejs_compat", "experimental"],

	"observability": { "enabled": true },

	// ─── KHÔNG dùng Workers Assets ở đây ────────────────────────────────
	// Đã thử `"assets": { "directory": "../frontend/dist", ... }` và
	// @cloudflare/vite-plugin BỎ IM LẶNG khối đó — config sinh ra ở
	// dist/vyling/wrangler.json có `assets: undefined` (crons/containers/DO
	// thì vẫn qua). Plugin tự quản assets từ client build của chính nó, mà
	// frontend/ là project Vite 5 riêng, không nằm trong build này.
	//
	// Nên frontend/dist đi vào image và FastAPI phục vụ y như hôm nay
	// (SpaStaticFiles, trang prerender, cache header — không lệch gì).
	// Xem cf/README.md §12 nếu muốn tối ưu sau.

	// ─── Sandbox: nơi chạy NGUYÊN VẸN app FastAPI hiện tại ──────────────
	// Không port sang Workers. Toàn bộ backend/ Python chạy trong container
	// Linux, Worker chỉ đứng trước làm reverse proxy.
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			// Dockerfile COPY backend/, requirements.txt ở GỐC repo, nên
			// build context phải trỏ lên trên (mặc định là thư mục chứa
			// Dockerfile, tức cf/ — sẽ báo "file not found").
			"image_build_context": "../",
			// Hợp lệ: lite | basic | standard-1..standard-4 (mặc định lite).
			// standard-2 cho ffmpeg; hạ xuống basic nếu chỉ chạy API thuần.
			"instance_type": "standard-2",
			"max_instances": 3
		}
	],

	"durable_objects": {
		"bindings": [
			{
				"class_name": "Sandbox",
				// Tên binding phải đúng là "Sandbox": proxyToSandbox() của
				// @cloudflare/sandbox đọc đúng khoá này trong env.
				"name": "Sandbox"
			},
		]
	},

	// Mỗi agent Flue = thêm 1 tag migration cho class sinh ra
	// (`Flue<PascalName>Agent`, lấy từ tên hàm agent).
	"migrations": [
		{
			"tag": "v1-sandbox",
			"new_sqlite_classes": ["Sandbox"]
		},
		{
			"tag": "flue-class-FlueVylingTutorAgent",
			"new_sqlite_classes": ["FlueVylingTutorAgent"]
		},
		{
			"tag": "flue-class-FlueVylingOpsAgent",
			"new_sqlite_classes": ["FlueVylingOpsAgent"]
		}
	],

	// ─── Agent vận hành dự án ───────────────────────────────────────────
	// Nhịp 30 phút TỰ kiểm tra bằng một HTTP request rẻ và im lặng khi mọi
	// thứ ổn — chỉ đánh thức model khi có sự cố. Nhịp 3h sáng viết báo cáo
	// ngày. Xem src/ops/scheduled.ts.
	// Giờ theo UTC: "0 3 * * *" = 10h sáng giờ Việt Nam (UTC+7).
	"triggers": {
		"crons": ["*/30 * * * *", "0 3 * * *"]
	},

	// Workers AI binding — Flue định tuyến model `cloudflare/...` qua đây.
	"ai": {
		"binding": "AI"
	},

	// ─── Code Mode (BETA) ───────────────────────────────────────────────
	// Worker Loader chạy code TypeScript agent sinh ra trong isolate riêng,
	// không có mạng ra ngoài — chỉ gọi được MCP qua binding.
	// Tài khoản chưa được cấp quyền beta: comment 3 dòng dưới, phần còn lại
	// vẫn deploy bình thường (xem cf/README.md §Code Mode).
	"worker_loaders": [{ "binding": "LOADER" }],

	// ─── R2: dữ liệu nặng KHÔNG nhét vào image ──────────────────────────
	// media/ (~420MB) + dictionaries/ (~18MB) + corpus cho AI Search.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "vyling-media",
			"preview_bucket_name": "vyling-media-dev"
		},
		{
			"binding": "KNOWLEDGE_BASE",
			"bucket_name": "vyling-knowledge",
			"preview_bucket_name": "vyling-knowledge-dev"
		}
	],

	"vars": {
		// Cổng uvicorn bên trong sandbox — khớp start.bat hiện tại.
		"APP_PORT": "8000",
		// Tên instance AI Search (tạo ở dashboard, xem cf/ai-search/).
		"AI_SEARCH_NAME": "vyling-knowledge",
		// Origin công khai — agent Flue dùng để tự cắm vào /mcp của chính nó.
		// Đổi thành domain thật khi có (vd "https://vyling.vn").
		"PUBLIC_URL": "https://vyling.workers.dev"
	}

	// Secrets (KHÔNG để trong file này — dùng `wrangler secret put`):
	//   LLM_API_KEY, JWT_SECRET, SMTP_PASSWORD,
	//   GOOGLE_CLIENT_SECRET, FACEBOOK_APP_SECRET
}
